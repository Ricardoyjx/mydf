# my-df environment template
# Copy to `.env` and fill in values:  cp .env.example .env
#
# NOTE: keep this file UTF-8 without BOM, LF line endings.
# Do NOT add Chinese comments (encoding safety, see AGENTS.md).

# ── LLM (fill at least one key) ──────────────────────────────────
MYDF_LLM_API_KEY=your_llm_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Model name (default: deepseek-v4-flash)
MYDF_LLM_MODEL=deepseek-v4-flash

# Debug / log level (debug|info|warning|error, default: info)
MYDF_DEBUG=false
MYDF_LOG_LEVEL=info

# Plan mode (TodoMiddleware, 0/1)
# MYDF_IS_PLAN_MODE=0

# ── Gateway ───────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001
GATEWAY_ENABLE_DOCS=true

# ── Checkpointer persistence ─────────────────────────────────────
# memory (in-process, lost on restart) | sqlite | postgres
MYDF_CHECKPOINTER_TYPE=postgres
MYDF_CHECKPOINTER_PATH=postgresql://postgres:postgres@localhost:5432/mydf

# Small-to-Big parent-child retrieval (true requires PostgreSQL; false keeps legacy flat chunks)
MYDF_RAG_SMALL_TO_BIG=false
MYDF_RAG_RRF_ENABLED=false

# Lightweight alternative: sqlite (single file, no Docker needed)
# MYDF_CHECKPOINTER_TYPE=sqlite
# MYDF_CHECKPOINTER_PATH=.my_df/checkpoints.db

# ── Embedding (RAG / semantic memory; lazy-loaded on first use) ──
MYDF_EMBEDDING_MODEL=all-MiniLM-L6-v2
HF_TOKEN=your_hf_token

# ── Reranker (lazy-loaded on first search) ───────────────────────
MYDF_RERANK_ENABLED=true
MYDF_RERANK_MODEL=BAAI/bge-reranker-base

# ── Milvus (optional, defaults to localhost:19530) ───────────────
MYDF_MILVUS_HOST=localhost
MYDF_MILVUS_PORT=19530
# MYDF_MILVUS_ALIAS=default
# MYDF_MILVUS_DIM=384
# MYDF_MILVUS_INDEX_TYPE=IVF_FLAT
# MYDF_MILVUS_COLLECTION_PREFIX=my_df_memory
# MYDF_MILVUS_NLIST=128

# ── Sandbox provider (class path or registered alias) ────────────
MYDF_SANDBOX_PROVIDER=my_df.sandbox.local_sandbox_provider.LocalSandboxProvider

# ── Paths (optional overrides) ───────────────────────────────────
# MYDF_HOME=
# MYDF_PROJECT_ROOT=
# MYDF_HOST_BASE_DIR=
